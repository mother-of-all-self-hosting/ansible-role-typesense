TZ={{ typesense_environment_variables_tz }}

{#
  See: https://typesense.org/docs/
#}

TYPESENSE_API_KEY={{ typesense_environment_variables_api_key }}
TYPESENSE_DATA_DIR=/data

{#
  Typesense listens on 8108 unless told otherwise. Without this line,
  `typesense_container_http_port` would only change the host-side port publishing and
  the Traefik label, while the process kept listening on 8108 - so any value other
  than the default silently produced a container nothing could reach.

  Variables in `typesense_environment_variables_additional_variables` are rendered
  after this one, and Docker's `--env-file` lets the last assignment win, so an
  operator who already worked around this by setting TYPESENSE_API_PORT there keeps
  their override.
#}
TYPESENSE_API_PORT={{ typesense_container_http_port }}

{{ typesense_environment_variables_additional_variables }}
