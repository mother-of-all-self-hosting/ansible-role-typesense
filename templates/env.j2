TYPESENSE_API_KEY={{ typesense_environment_variables_api_key }}
TYPESENSE_DATA_DIR=/data

UID={{ typesense_uid }}
GID={{ typesense_gid }}

OG_LOG_LEVEL={{ typesense_environment_variables_log_level }}
OG_LOG_OUTPUT={{ typesense_environment_variables_log_output }}
OG_EXTERNAL_URL={{ typesense_scheme }}://{{ typesense_hostname }}

{% if typesense_database_type == 'sqlite' %}
OG_DB_URI={{ typesense_database_filename }}
{% endif %}

{% if typesense_database_type == 'mysql' %}
OG_DB_URI=mysql://{{ typesense_database_mysql_username }}:{{ typesense_database_mysql_password }}@{{ typesense_database_mysql_hostname }}:{{ typesense_database_mysql_port }}/{{ typesense_database_name }}
{% endif %}

{% if typesense_database_type == 'postgres' %}
OG_DB_URI=postgres://{{ typesense_database_postgres_username }}:{{ typesense_database_postgres_password }}@{{ typesense_database_postgres_hostname }}:{{ typesense_database_postgres_port }}/{{ typesense_database_name }}
{% endif %}

OG_HTTP_PORT={{ typesense_container_http_port }}
OG_HTTP_GIT_ENABLED={{ typesense_environment_variables_http_git_enabled | to_json }}

OG_METRICS_ENABLED={{ typesense_environment_variables_metrics_enabled | to_json }}
OG_SSH_GIT_ENABLED={{ typesense_environment_variables_ssh_git_enabled | to_json }}

OG_SSH_PORT={{ typesense_container_ssh_port }}

{{ typesense_environment_variables_additional_variables }}
